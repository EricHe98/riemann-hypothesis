namespace UpperTheory.V.Z.Gam

open NumberField IsDedekindDomain Polynomial GlobalTheory.LocGL GroundTheory.Global.SemiLocal
open UpperTheory.V.Z.ImaginaryQuadraticEtaCharacter

private theorem pol_zero_degree {k : Type} [Field k] [ValuativeRel k] [TopologicalSpace k]
    [IsNonarchimedeanLocalField k] (s : Multiset (IrrGL (k := k))) (χ : kˣ →* ℂˣ) :
    (pol s χ).eval 0 = 1 ∧ (pol s χ).natDegree = cnt s χ := by
  have h := (polFacts k).2.2.2 s χ
  exact ⟨h.1, h.2.1⟩

private theorem degree_place_product {ι : Type*} [Fintype ι]
    (P : ι → ℂ[X]) (d c : ι → ℕ) (hd : ∀ i, 0 < d i)
    (hP : ∀ i, (P i).eval 0 = 1 ∧ (P i).natDegree = c i) :
    (∏ i, (P i).comp (X ^ d i)).natDegree = ∑ i, d i * c i := by
  classical
  have hne (i : ι) : (P i).comp (X ^ d i) ≠ 0 := by
    intro he
    have h := congrArg (Polynomial.eval (0 : ℂ)) he
    simpa [eval_comp, zero_pow (hd i).ne', (hP i).1] using h
  rw [natDegree_prod _ _ fun i _ => hne i]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [natDegree_comp, natDegree_X_pow, (hP i).2, Nat.mul_comm]

private theorem matchBC_counts : MatchBC := by
  intro K L _ _ _ _ _ _ _ _ hp n hn π P hBC η hη v s s' hs hs' θ hθ
  classical
  have h := matchBCX K L hp n hn π P hBC η hη v s s' hs hs' θ hθ
  have hne (j : ℕ) : pol s (θ * (η ^ j).loc v) ≠ 0 := by
    intro he
    simpa [he] using (pol_zero_degree s (θ * (η ^ j).loc v)).1
  calc
    _ = (∏ j ∈ Finset.range (Module.finrank K L), pol s (θ * (η ^ j).loc v)).natDegree := by
      rw [natDegree_prod _ _ fun j _ => hne j]
      exact Finset.sum_congr rfl fun j _ => (pol_zero_degree s (θ * (η ^ j).loc v)).2.symm
    _ = _ := congrArg Polynomial.natDegree h
    _ = _ := degree_place_product _ _ _ (fun w => (normVal K L v w 1).2.2.1)
      (fun w => pol_zero_degree (s' w) (θ.comp (nm w)))

private theorem matchInd_counts : MatchInd := by
  intro K M _ _ _ _ _ _ _ h2 P π hsys v s s' hs hs' θ hθ
  classical
  have h := matchIndX K M h2 P π hsys v s s' hs hs' θ hθ
  calc
    _ = (pol s θ).natDegree := (pol_zero_degree s θ).2.symm
    _ = _ := congrArg Polynomial.natDegree h
    _ = _ := degree_place_product _ _ _ (fun w => (normVal K M v w 1).2.2.1)
      (fun w => pol_zero_degree (s' w) (θ.comp (nm w)))

theorem upDown : UpDown := upDownOf suppFacts normCnt matchBC_counts

theorem indTor : IndTor := indTorOf suppFacts normCnt matchInd_counts

